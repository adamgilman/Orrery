{
  "title": "Ride-hailing platform",
  "direction": "right",
  "states": {
    "default": "healthy",
    "needs": {
      "unmet": "outage",
      "reduced": "impaired"
    },
    "replace": true,
    "define": {
      "healthy": {
        "look": "normal",
        "rank": 0,
        "available": true,
        "description": "Serving normally."
      },
      "impaired": {
        "look": "warn",
        "rank": 1,
        "available": true,
        "description": "Serving, but with reduced redundancy or a nice-to-have missing."
      },
      "brownout": {
        "look": {
          "stroke": "#7c3aed",
          "fill": "#f5f3ff",
          "text": "#4c1d95",
          "pulse": true
        },
        "rank": 1,
        "available": true,
        "description": "Deliberately shedding load: surge pricing and ETA predictions switched off."
      },
      "outage": {
        "look": "alert",
        "rank": 2,
        "available": false,
        "flows": "stop",
        "description": "Down. Not serving."
      },
      "maintenance": {
        "look": "muted",
        "rank": 2,
        "available": false,
        "flows": "stop",
        "cascade": "children",
        "description": "Taken out of service on purpose; everything inside it too."
      }
    }
  },
  "kinds": {
    "components": {
      "ml-model": {
        "glyph": "M2 12l3-4 3 2 3-5 3 3v4H2z",
        "box": {
          "dash": true,
          "fill": "#f0fdf4",
          "stroke": "#15803d"
        },
        "description": "A served machine-learning model."
      }
    },
    "groups": {
      "cell": {
        "frame": {
          "stroke": "#0891b2",
          "dash": true,
          "fill": "#ecfeff",
          "fillOpacity": 0.4
        },
        "description": "An isolated deployment cell."
      }
    }
  },
  "groups": [
    {
      "id": "edge",
      "label": "Riders and drivers",
      "kind": "tier"
    },
    {
      "id": "us-east",
      "label": "us-east-1",
      "kind": "region"
    },
    {
      "id": "core",
      "label": "Core services",
      "kind": "tier",
      "parent": "us-east"
    },
    {
      "id": "data",
      "label": "Data tier",
      "kind": "tier",
      "parent": "us-east"
    },
    {
      "id": "partners",
      "label": "Third parties",
      "kind": "boundary"
    },
    {
      "id": "config",
      "label": "Config store",
      "kind": "cell",
      "parent": "data",
      "description": "3-node etcd cluster; needs a quorum of 2."
    }
  ],
  "components": [
    {
      "id": "rider-app",
      "label": "Rider app",
      "kind": "client",
      "group": "edge",
      "tech": "iOS / Android",
      "needs": [
        "api-gateway"
      ]
    },
    {
      "id": "driver-app",
      "label": "Driver app",
      "kind": "client",
      "group": "edge",
      "tech": "Android"
    },
    {
      "id": "api-gateway",
      "label": "API gateway",
      "kind": "gateway",
      "group": "core",
      "replicas": 3,
      "needs": [
        "trip-service",
        {
          "any": [
            "pricing"
          ],
          "unmet": "impaired"
        }
      ]
    },
    {
      "id": "trip-service",
      "label": "Trip service",
      "kind": "service",
      "group": "core",
      "replicas": 4,
      "tech": "Go",
      "needs": [
        {
          "any": [
            "trip-db",
            "trip-db-replica"
          ]
        },
        {
          "any": [
            "etcd-1",
            "etcd-2",
            "etcd-3"
          ],
          "min": 2
        },
        "matching",
        "partners"
      ]
    },
    {
      "id": "matching",
      "label": "Matching service",
      "kind": "service",
      "group": "core",
      "replicas": 2,
      "tech": "Go",
      "needs": [
        "location-cache",
        {
          "any": [
            "maps"
          ],
          "unmet": "impaired"
        },
        {
          "any": [
            "eta-model"
          ],
          "unmet": "impaired"
        }
      ]
    },
    {
      "id": "pricing",
      "label": "Pricing service",
      "kind": "service",
      "group": "core",
      "tech": "Python",
      "needs": [
        {
          "any": [
            "surge"
          ],
          "unmet": "impaired"
        }
      ]
    },
    {
      "id": "surge",
      "label": "Surge calculator",
      "kind": "function",
      "group": "core",
      "tech": "Lambda"
    },
    {
      "id": "trip-db",
      "label": "Trip DB (primary)",
      "kind": "database",
      "group": "data",
      "tech": "PostgreSQL 16"
    },
    {
      "id": "trip-db-replica",
      "label": "Trip DB (replica)",
      "kind": "database",
      "group": "data",
      "tech": "PostgreSQL 16"
    },
    {
      "id": "location-cache",
      "label": "Driver locations",
      "kind": "cache",
      "group": "data",
      "tech": "Redis 7"
    },
    {
      "id": "trip-events",
      "label": "Trip events",
      "kind": "queue",
      "group": "data",
      "tech": "Kafka"
    },
    {
      "id": "history",
      "label": "Ride history",
      "kind": "storage",
      "group": "data",
      "tech": "S3"
    },
    {
      "id": "maps",
      "label": "Maps provider",
      "kind": "external",
      "group": "partners"
    },
    {
      "id": "payments",
      "label": "Payments processor",
      "kind": "external",
      "group": "partners"
    },
    {
      "id": "etcd-1",
      "label": "etcd 1",
      "kind": "database",
      "group": "config",
      "tech": "etcd 3.5"
    },
    {
      "id": "etcd-2",
      "label": "etcd 2",
      "kind": "database",
      "group": "config",
      "tech": "etcd 3.5"
    },
    {
      "id": "etcd-3",
      "label": "etcd 3",
      "kind": "database",
      "group": "config",
      "tech": "etcd 3.5"
    },
    {
      "id": "eta-model",
      "label": "ETA model",
      "kind": "ml-model",
      "group": "core",
      "tech": "PyTorch / Triton",
      "replicas": 2
    }
  ],
  "connections": [
    {
      "from": "rider-app",
      "to": "api-gateway",
      "kind": "sync",
      "label": "HTTPS",
      "load": 0.8
    },
    {
      "from": "driver-app",
      "to": "api-gateway",
      "kind": "sync",
      "label": "HTTPS",
      "load": 0.6
    },
    {
      "from": "driver-app",
      "to": "location-cache",
      "kind": "dataflow",
      "label": "GPS pings",
      "load": 0.9
    },
    {
      "from": "api-gateway",
      "to": "trip-service",
      "kind": "sync",
      "label": "gRPC",
      "load": 0.8
    },
    {
      "from": "api-gateway",
      "to": "pricing",
      "kind": "sync",
      "label": "gRPC",
      "load": 0.4
    },
    {
      "from": "trip-service",
      "to": "matching",
      "kind": "sync",
      "label": "gRPC",
      "load": 0.5
    },
    {
      "from": "trip-service",
      "to": "trip-db",
      "kind": "sync",
      "label": "SQL writes",
      "load": 0.7
    },
    {
      "from": "trip-service",
      "to": "trip-db-replica",
      "kind": "sync",
      "label": "SQL reads",
      "load": 0.3
    },
    {
      "from": "trip-db",
      "to": "trip-db-replica",
      "kind": "replication",
      "label": "streaming",
      "load": 0.5
    },
    {
      "from": "trip-service",
      "to": "trip-events",
      "kind": "async",
      "label": "publish",
      "load": 0.6
    },
    {
      "from": "trip-events",
      "to": "history",
      "kind": "dataflow",
      "label": "archive",
      "load": 0.4
    },
    {
      "from": "matching",
      "to": "location-cache",
      "kind": "sync",
      "label": "GEO queries",
      "load": 0.7
    },
    {
      "from": "pricing",
      "to": "surge",
      "kind": "sync",
      "label": "invoke",
      "load": 0.3
    },
    {
      "from": "surge",
      "to": "location-cache",
      "kind": "sync",
      "label": "density",
      "load": 0.2
    },
    {
      "from": "trip-service",
      "to": "partners",
      "kind": "sync",
      "label": "charge / route",
      "load": 0.4
    },
    {
      "from": "matching",
      "to": "maps",
      "kind": "sync",
      "label": "ETA",
      "load": 0.5
    },
    {
      "from": "trip-service",
      "to": "etcd-1",
      "kind": "sync",
      "label": "watch",
      "load": 0.2
    },
    {
      "from": "trip-service",
      "to": "etcd-2",
      "kind": "sync",
      "label": "watch",
      "load": 0.2
    },
    {
      "from": "trip-service",
      "to": "etcd-3",
      "kind": "sync",
      "label": "watch",
      "load": 0.2
    },
    {
      "from": "matching",
      "to": "eta-model",
      "kind": "sync",
      "label": "predict",
      "load": 0.5
    }
  ],
  "scenarios": [
    {
      "id": "primary-db-outage",
      "label": "Trip DB primary goes down, then an etcd node too",
      "steps": [
        {
          "note": "Primary trip DB crashes. Trip service falls back to the replica; reads keep working, writes queue.",
          "set": {
            "outage": "trip-db"
          }
        },
        {
          "note": "While repairing, etcd-1 is also lost. Config quorum is 2 of 3, so it still holds.",
          "set": {
            "outage": "etcd-1"
          }
        },
        {
          "note": "To protect the replica, pricing and ETA predictions are switched to brownout.",
          "set": {
            "brownout": [
              "pricing",
              "eta-model"
            ]
          }
        },
        {
          "note": "etcd-1 returns. Quorum back to full strength.",
          "restore": "etcd-1"
        },
        {
          "note": "Primary DB restored; brownout lifted.",
          "restore": [
            "trip-db",
            "pricing",
            "eta-model"
          ]
        }
      ]
    },
    {
      "id": "data-tier-maintenance",
      "label": "Planned maintenance on the whole data tier",
      "steps": [
        {
          "note": "Data tier taken out for maintenance. Everything inside it goes with it.",
          "set": {
            "maintenance": "data"
          }
        },
        {
          "note": "Maintenance over.",
          "restore": "data"
        }
      ]
    }
  ]
}