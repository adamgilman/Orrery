{
  "$schema": "https://orrery.dev/schema/v1.json",
  "title": "Nested groups",
  "direction": "down",
  "groups": [
    {
      "id": "region",
      "label": "eu-west-1",
      "kind": "region"
    },
    {
      "id": "web",
      "label": "Web tier",
      "kind": "tier",
      "parent": "region"
    },
    {
      "id": "data",
      "label": "Data tier",
      "kind": "tier",
      "parent": "region"
    },
    {
      "id": "pci",
      "label": "PCI boundary",
      "kind": "boundary",
      "parent": "region"
    }
  ],
  "nodes": [
    {
      "id": "cdn",
      "label": "CDN",
      "kind": "gateway"
    },
    {
      "id": "app",
      "label": "App",
      "kind": "service",
      "group": "web"
    },
    {
      "id": "db",
      "label": "Orders DB",
      "kind": "database",
      "group": "data"
    },
    {
      "id": "vault",
      "label": "Card vault",
      "kind": "storage",
      "group": "pci"
    }
  ],
  "edges": [
    {
      "from": "cdn",
      "to": "app",
      "load": 0.8
    },
    {
      "from": "app",
      "to": "db",
      "load": 0.5
    },
    {
      "from": "app",
      "to": "vault",
      "load": 0.2
    }
  ]
}
