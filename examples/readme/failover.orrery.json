{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Failover",
  "direction": "down",
  "components": [
    {
      "id": "web",
      "label": "Web",
      "kind": "gateway",
      "needs": [
        "api"
      ]
    },
    {
      "id": "api",
      "label": "API",
      "kind": "service",
      "needs": [
        {
          "any": [
            "db",
            "replica"
          ]
        }
      ]
    },
    {
      "id": "db",
      "label": "Primary",
      "kind": "database"
    },
    {
      "id": "replica",
      "label": "Replica",
      "kind": "database"
    },
    {
      "id": "worker",
      "label": "Worker",
      "kind": "function",
      "needs": [
        "db"
      ]
    }
  ],
  "connections": [
    {
      "from": "web",
      "to": "api",
      "load": 0.8
    },
    {
      "from": "api",
      "to": "db",
      "load": 0.6
    },
    {
      "from": "api",
      "to": "replica",
      "label": "failover",
      "load": 0
    },
    {
      "from": "db",
      "to": "replica",
      "load": 0.2,
      "kind": "replication"
    },
    {
      "from": "worker",
      "to": "db",
      "load": 0.2
    }
  ],
  "scenarios": [
    {
      "id": "db-fails",
      "label": "Primary fails",
      "steps": [
        {
          "note": "Primary goes down",
          "set": {
            "failed": "db"
          }
        }
      ]
    }
  ]
}
