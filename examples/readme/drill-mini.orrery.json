{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Drill-down, minimal",
  "direction": "down",
  "groups": [
    {
      "id": "orders",
      "label": "Orders",
      "kind": "tier"
    },
    {
      "id": "shipping",
      "label": "Shipping",
      "kind": "tier"
    }
  ],
  "components": [
    {
      "id": "app",
      "label": "App",
      "kind": "client",
      "needs": [
        "orders"
      ]
    },
    {
      "id": "api",
      "label": "Orders API",
      "kind": "service",
      "group": "orders",
      "needs": [
        "db"
      ]
    },
    {
      "id": "db",
      "label": "Orders DB",
      "kind": "database",
      "group": "orders"
    },
    {
      "id": "ship",
      "label": "Shipping API",
      "kind": "service",
      "group": "shipping",
      "needs": [
        "carriers"
      ]
    },
    {
      "id": "carriers",
      "label": "Carriers",
      "kind": "external",
      "group": "shipping"
    },
    {
      "id": "mail",
      "label": "Mail provider",
      "kind": "external"
    }
  ],
  "connections": [
    {
      "from": "app",
      "to": "api",
      "load": 0.7
    },
    {
      "from": "api",
      "to": "db",
      "load": 0.5
    },
    {
      "from": "api",
      "to": "ship",
      "load": 0.3
    },
    {
      "from": "ship",
      "to": "carriers",
      "load": 0.3,
      "kind": "async"
    },
    {
      "from": "api",
      "to": "mail",
      "load": 0.2,
      "kind": "async"
    }
  ],
  "views": [
    {
      "id": "overview",
      "collapse": [
        "orders",
        "shipping"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "db-fails",
      "label": "DB fails",
      "steps": [
        {
          "note": "The database goes down",
          "set": {
            "failed": "db"
          }
        }
      ]
    }
  ],
  "tour": {
    "seconds": 3,
    "scenes": [
      {
        "view": "overview",
        "note": "Orders is closed."
      },
      {
        "view": "overview",
        "focus": "orders",
        "note": "Inside Orders."
      },
      {
        "view": "overview",
        "focus": "orders",
        "scenario": "db-fails",
        "step": 1,
        "note": "The database fails; the API fails with it."
      },
      {
        "view": "overview",
        "scenario": "db-fails",
        "step": 1,
        "note": "Back out: Orders and the app are down."
      }
    ]
  }
}
