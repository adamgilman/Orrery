{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Multi-region e-commerce platform",
  "direction": "right",
  "groups": [
    {
      "id": "edge",
      "label": "Global edge",
      "kind": "boundary"
    },
    {
      "id": "us-east",
      "label": "us-east-1 (primary)",
      "kind": "region"
    },
    {
      "id": "us-east-web",
      "label": "Web tier",
      "kind": "tier",
      "parent": "us-east"
    },
    {
      "id": "us-east-data",
      "label": "Data tier",
      "kind": "tier",
      "parent": "us-east"
    },
    {
      "id": "eu-west",
      "label": "eu-west-1 (read replica)",
      "kind": "region"
    },
    {
      "id": "eu-west-data",
      "label": "Data tier",
      "kind": "tier",
      "parent": "eu-west"
    }
  ],
  "components": [
    {
      "id": "shopper",
      "label": "Shopper browser / app",
      "kind": "client"
    },
    {
      "id": "cdn",
      "label": "CDN + WAF",
      "kind": "gateway",
      "group": "edge"
    },
    {
      "id": "assets",
      "label": "Static asset bucket",
      "kind": "storage",
      "group": "edge"
    },
    {
      "id": "api-us",
      "label": "API gateway",
      "kind": "gateway",
      "group": "us-east-web"
    },
    {
      "id": "checkout-us",
      "label": "Checkout service",
      "kind": "service",
      "group": "us-east-web"
    },
    {
      "id": "catalog-us",
      "label": "Catalog service",
      "kind": "service",
      "group": "us-east-web"
    },
    {
      "id": "orders-db-us",
      "label": "Orders DB (primary)",
      "kind": "database",
      "group": "us-east-data"
    },
    {
      "id": "catalog-cache-us",
      "label": "Catalog cache",
      "kind": "cache",
      "group": "us-east-data"
    },
    {
      "id": "order-events",
      "label": "Order events",
      "kind": "queue",
      "group": "us-east-data"
    },
    {
      "id": "fulfillment-fn",
      "label": "Fulfillment worker",
      "kind": "function",
      "group": "us-east"
    },
    {
      "id": "api-eu",
      "label": "API gateway",
      "kind": "gateway",
      "group": "eu-west"
    },
    {
      "id": "orders-db-eu",
      "label": "Orders DB (replica)",
      "kind": "database",
      "group": "eu-west-data"
    },
    {
      "id": "payments",
      "label": "Payment provider",
      "kind": "external"
    }
  ],
  "connections": [
    {
      "from": "shopper",
      "to": "cdn",
      "label": "HTTPS",
      "kind": "sync",
      "load": 1
    },
    {
      "from": "cdn",
      "to": "assets",
      "label": "static files",
      "kind": "dataflow",
      "load": 0.8
    },
    {
      "from": "cdn",
      "to": "api-us",
      "label": "geo-route NA",
      "kind": "sync",
      "load": 0.7
    },
    {
      "from": "cdn",
      "to": "api-eu",
      "label": "geo-route EU",
      "kind": "sync",
      "load": 0.4
    },
    {
      "from": "api-us",
      "to": "catalog-us",
      "label": "GET /products",
      "kind": "sync",
      "load": 0.8
    },
    {
      "from": "api-us",
      "to": "checkout-us",
      "label": "POST /orders",
      "kind": "sync",
      "load": 0.5
    },
    {
      "from": "catalog-us",
      "to": "catalog-cache-us",
      "label": "read-through",
      "kind": "sync",
      "load": 0.9
    },
    {
      "id": "checkout-writes-orders",
      "from": "checkout-us",
      "to": "orders-db-us",
      "label": "insert order",
      "kind": "sync",
      "load": 0.5
    },
    {
      "id": "checkout-archives-orders",
      "from": "checkout-us",
      "to": "orders-db-us",
      "label": "nightly archive",
      "kind": "dataflow",
      "load": 0.1
    },
    {
      "id": "checkout-authorizes-payment",
      "from": "checkout-us",
      "to": "payments",
      "label": "authorize card",
      "kind": "sync",
      "load": 0.5
    },
    {
      "id": "payment-webhook",
      "from": "payments",
      "to": "checkout-us",
      "label": "capture webhook",
      "kind": "async",
      "load": 0.3
    },
    {
      "from": "checkout-us",
      "to": "order-events",
      "label": "OrderPlaced",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "order-events",
      "to": "fulfillment-fn",
      "label": "trigger",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "fulfillment-fn",
      "to": "orders-db-us",
      "label": "update status",
      "kind": "sync",
      "load": 0.3
    },
    {
      "from": "orders-db-us",
      "to": "orders-db-eu",
      "label": "cross-region replica",
      "kind": "replication",
      "load": 0.6
    },
    {
      "from": "api-eu",
      "to": "orders-db-eu",
      "label": "read order history",
      "kind": "sync",
      "load": 0.3
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Global overview",
      "type": "topology",
      "direction": "right"
    },
    {
      "id": "us-east-detail",
      "title": "us-east-1 primary region",
      "type": "topology",
      "direction": "down",
      "scope": "us-east"
    }
  ]
}
