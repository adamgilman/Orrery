{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Checkout: three-tier with read replica",
  "direction": "right",
  "components": [
    {
      "id": "cdn",
      "label": "CDN"
    },
    {
      "id": "web",
      "label": "Web tier"
    },
    {
      "id": "api",
      "label": "Checkout API"
    },
    {
      "id": "cache",
      "label": "Session cache"
    },
    {
      "id": "db",
      "label": "Orders DB (primary)"
    },
    {
      "id": "replica",
      "label": "Orders DB (replica)"
    },
    {
      "id": "queue",
      "label": "Events queue"
    },
    {
      "id": "worker",
      "label": "Fulfilment worker"
    }
  ],
  "connections": [
    {
      "from": "cdn",
      "to": "web",
      "load": 0.9,
      "label": "HTTPS"
    },
    {
      "from": "web",
      "to": "api",
      "load": 0.7,
      "label": "REST"
    },
    {
      "from": "api",
      "to": "cache",
      "load": 0.6
    },
    {
      "from": "api",
      "to": "db",
      "load": 0.5,
      "label": "writes"
    },
    {
      "from": "api",
      "to": "replica",
      "load": 0.3,
      "label": "reads"
    },
    {
      "from": "db",
      "to": "replica",
      "load": 0.2,
      "label": "replication"
    },
    {
      "from": "api",
      "to": "queue",
      "load": 0.4
    },
    {
      "from": "queue",
      "to": "worker",
      "load": 0.4
    },
    {
      "from": "worker",
      "to": "db",
      "load": 0.1
    }
  ]
}
