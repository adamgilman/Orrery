{
  "$schema": "../packages/core/schema/v1.json",
  "title": "How Orrery works",
  "description": "Orrery, drawn in Orrery. An agent writes one file: the model, its views, scenarios, tour and exports. The command line validates it, folds the declared states in, scopes a view, lays it out through an engine behind one interface, and renders SVG that animates in a README and is interactive in a browser. This diagram uses every feature the model offers, and the test suite checks that it keeps doing so.",
  "direction": "right",
  "states": {
    "use": "sre",
    "replace": false,
    "define": {
      "planned": {
        "look": {
          "stroke": "#94a3b8",
          "fill": "#f8fafc",
          "text": "#64748b",
          "dash": true,
          "pulse": false,
          "opacity": 0.7
        },
        "flows": "stop",
        "description": "On the roadmap, not built"
      },
      "brownout": {
        "description": "Working with a feature switched off"
      },
      "retired": {
        "look": "muted",
        "description": "Kept so old files still validate"
      }
    },
    "default": "healthy"
  },
  "kinds": {
    "use": [
      "aws",
      "gcp",
      "azure"
    ],
    "replace": false,
    "components": {
      "file": {
        "glyph": "M3 1.5h7l3.5 3.5v9.5H3z M10 1.5V5h3.5",
        "shape": "document",
        "description": "A file on disk"
      },
      "command": {
        "glyph": "function",
        "shape": "tag",
        "box": {
          "fill": "#f8fafc",
          "stroke": "#475569"
        },
        "description": "A subcommand of the orrery CLI"
      },
      "engine": {
        "glyph": "gateway",
        "shape": "hexagon",
        "description": "A layout engine behind the LayoutEngine interface"
      },
      "word": {
        "glyph": "M2 4h12M2 8h8M2 12h10",
        "shape": "pill",
        "description": "A block of the author's vocabulary",
        "box": {
          "dash": true
        }
      },
      "stage": {
        "shape": "chevron",
        "description": "A stage of the rendering pipeline"
      },
      "mark": {
        "glyph": {
          "viewBox": "0 0 16 16",
          "svg": "<circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"none\" stroke=\"#FF7A1A\" stroke-width=\"1.5\"/><circle cx=\"8\" cy=\"8\" r=\"2\" fill=\"#FF7A1A\"/><circle cx=\"13\" cy=\"5\" r=\"1.2\" fill=\"#0f172a\"/>"
        },
        "description": "The orrery mark: an interactive file with the engine inside"
      }
    },
    "groups": {
      "package": {
        "frame": "tier",
        "description": "A published npm package"
      },
      "documents": {
        "frame": {
          "stroke": "#94a3b8",
          "fill": "#f1f5f9",
          "fillOpacity": 0.6,
          "dash": true
        },
        "shape": "cloud",
        "description": "What comes out, wherever it is read"
      },
      "sets": {
        "frame": {
          "stroke": "#94a3b8",
          "dotted": true
        },
        "description": "Someone else's icon sets"
      }
    },
    "connections": {
      "reads": {
        "line": {
          "dash": "2 3",
          "stroke": "#0891b2",
          "flow": "#0891b2"
        },
        "description": "Read, not called"
      },
      "inlined": {
        "line": {
          "width": 2.5,
          "stroke": "#7c3aed",
          "flow": "#7c3aed"
        },
        "description": "Copied into the file verbatim"
      },
      "builds": {
        "line": "dotted",
        "description": "Generated by a script and committed"
      }
    }
  },
  "shapes": {
    "replace": false,
    "define": {
      "chevron": {
        "path": "M0 0H85L100 50 85 100H0L15 50Z",
        "pad": {
          "x": 16,
          "y": 0
        },
        "description": "A stage in a pipeline"
      },
      "tag": {
        "path": "M0 0H82L100 50 82 100H0Z",
        "pad": {
          "x": 12,
          "y": 0
        },
        "description": "A command"
      },
      "box": {
        "corner": 8
      },
      "pill": {
        "corner": "round",
        "pad": {
          "x": 6,
          "y": 0
        }
      }
    }
  },
  "groups": [
    {
      "id": "cli",
      "label": "orrery-diagrams",
      "kind": "package",
      "description": "The command line: validate, render, export, embed, packs"
    },
    {
      "id": "icon-sets",
      "label": "The providers' icon sets",
      "kind": "sets",
      "description": "Built into packs by a script and committed"
    },
    {
      "id": "core",
      "label": "@orrery-diagrams/core",
      "kind": "package"
    },
    {
      "id": "vocabulary",
      "label": "Vocabulary",
      "kind": "cluster",
      "parent": "core",
      "description": "States, kinds, shapes and packs: presets the author overrides, extends or replaces"
    },
    {
      "id": "packs",
      "label": "Packs",
      "kind": "cluster",
      "parent": "vocabulary",
      "description": "aws, gcp and azure as kinds; sre as states",
      "meta": {
        "built-by": "tools/packs/build.mjs"
      }
    },
    {
      "id": "layout",
      "label": "@orrery-diagrams/layout-elk",
      "kind": "package"
    },
    {
      "id": "runtime",
      "label": "@orrery-diagrams/runtime",
      "kind": "package",
      "description": "The engine inlined into every interactive file"
    },
    {
      "id": "outputs",
      "label": "What comes out",
      "kind": "documents"
    },
    {
      "id": "raster",
      "label": "@orrery-diagrams/raster",
      "kind": "package",
      "state": "healthy"
    }
  ],
  "components": [
    {
      "id": "agent",
      "label": "Coding agent",
      "kind": "client",
      "tech": "or a person",
      "description": "Writes the model from the schema and the specification"
    },
    {
      "id": "model",
      "label": "app.orrery.json",
      "kind": "file",
      "tech": "one file",
      "meta": {
        "spec": "docs/MODEL.md"
      }
    },
    {
      "id": "schema",
      "label": "JSON Schema",
      "kind": "file",
      "tech": "v1.json",
      "description": "Every property explains itself"
    },
    {
      "id": "validate",
      "label": "validate",
      "kind": "command",
      "group": "cli"
    },
    {
      "id": "render",
      "label": "render",
      "kind": "command",
      "group": "cli"
    },
    {
      "id": "export",
      "label": "export / embed",
      "kind": "command",
      "group": "cli"
    },
    {
      "id": "explain",
      "label": "explain",
      "kind": "command",
      "group": "cli",
      "state": "planned",
      "description": "The model and a scenario in prose (N2)"
    },
    {
      "id": "aws-set",
      "label": "AWS icons",
      "kind": "aws:lambda",
      "group": "icon-sets"
    },
    {
      "id": "gcp-set",
      "label": "Google Cloud icons",
      "kind": "gcp:run",
      "group": "icon-sets"
    },
    {
      "id": "azure-set",
      "label": "Azure icons",
      "kind": "azure:functions",
      "group": "icon-sets"
    },
    {
      "id": "states",
      "label": "States",
      "kind": "word",
      "group": "vocabulary"
    },
    {
      "id": "kinds",
      "label": "Kinds",
      "kind": "word",
      "group": "vocabulary"
    },
    {
      "id": "shapes",
      "label": "Shapes",
      "kind": "word",
      "group": "vocabulary"
    },
    {
      "id": "aws-pack",
      "label": "aws",
      "kind": "aws:lambda",
      "group": "packs"
    },
    {
      "id": "gcp-pack",
      "label": "gcp",
      "kind": "gcp:run",
      "group": "packs"
    },
    {
      "id": "azure-pack",
      "label": "azure",
      "kind": "azure:functions",
      "group": "packs"
    },
    {
      "id": "sre-pack",
      "label": "sre",
      "kind": "word",
      "group": "packs"
    },
    {
      "id": "validator",
      "label": "Validate",
      "kind": "stage",
      "group": "core",
      "tech": "schema + pointers"
    },
    {
      "id": "declare",
      "label": "Declare",
      "kind": "stage",
      "group": "core",
      "tech": "states, reasons, loads"
    },
    {
      "id": "scope",
      "label": "Scope",
      "kind": "stage",
      "group": "core",
      "tech": "views, closed groups"
    },
    {
      "id": "elk",
      "label": "ELK",
      "kind": "engine",
      "group": "layout",
      "tech": "elkjs 0.9"
    },
    {
      "id": "fake",
      "label": "Fake engine",
      "kind": "engine",
      "group": "layout",
      "tech": "tests",
      "description": "A row or a column; what the renderer tests run against"
    },
    {
      "id": "renderer",
      "label": "Render",
      "kind": "stage",
      "group": "core",
      "tech": "SVG + CSS"
    },
    {
      "id": "page",
      "label": "Your page",
      "kind": "client",
      "tech": "orrery embed",
      "description": "Mounts the engine and builds its own controls"
    },
    {
      "id": "camera",
      "label": "Camera",
      "group": "runtime"
    },
    {
      "id": "session",
      "label": "Session",
      "group": "runtime",
      "tech": "declare + overrides"
    },
    {
      "id": "morph",
      "label": "Morph",
      "group": "runtime",
      "description": "Slides shared boxes between layouts"
    },
    {
      "id": "scene",
      "label": "Scene SVGs",
      "kind": "file",
      "group": "outputs",
      "replicas": 3,
      "tech": "CSS animation only"
    },
    {
      "id": "interactive",
      "label": "Interactive SVG",
      "kind": "mark",
      "group": "outputs",
      "tech": "model + engine inside"
    },
    {
      "id": "readme",
      "label": "GitHub README",
      "kind": "external",
      "tech": "an img tag"
    },
    {
      "id": "browser",
      "label": "Browser",
      "kind": "client"
    },
    {
      "id": "freeze",
      "label": "Freeze at t",
      "group": "raster"
    },
    {
      "id": "resvg",
      "label": "resvg",
      "kind": "external",
      "group": "raster",
      "tech": "native"
    },
    {
      "id": "png",
      "label": "PNG frames",
      "kind": "file",
      "group": "outputs"
    }
  ],
  "connections": [
    {
      "from": "agent",
      "to": "model",
      "load": 0.8,
      "label": "writes"
    },
    {
      "from": "agent",
      "to": "schema",
      "kind": "reads",
      "load": 0.3,
      "label": "reads"
    },
    {
      "id": "to-validate",
      "from": "model",
      "to": "validate",
      "load": 0.5
    },
    {
      "id": "to-render",
      "from": "model",
      "to": "render",
      "load": 0.7
    },
    {
      "from": "model",
      "to": "export",
      "load": 0.6
    },
    {
      "from": "validate",
      "to": "validator",
      "load": 0.5
    },
    {
      "from": "render",
      "to": "validator",
      "load": 0.7
    },
    {
      "from": "export",
      "to": "validator",
      "load": 0.6
    },
    {
      "from": "schema",
      "to": "validator",
      "kind": "reads",
      "load": 0.4
    },
    {
      "from": "vocabulary",
      "to": "validator",
      "kind": "async",
      "load": 0.3,
      "label": "merged before yours"
    },
    {
      "from": "validator",
      "to": "declare",
      "load": 0.7
    },
    {
      "from": "declare",
      "to": "scope",
      "load": 0.7
    },
    {
      "id": "to-elk",
      "from": "scope",
      "to": "elk",
      "load": 0.7,
      "label": "layout graph / boxes and routes",
      "bidirectional": true
    },
    {
      "id": "to-fake",
      "from": "scope",
      "to": "fake",
      "load": 0,
      "bidirectional": true
    },
    {
      "id": "to-draw",
      "from": "scope",
      "to": "renderer",
      "load": 0.7,
      "label": "laid out"
    },
    {
      "from": "runtime",
      "to": "interactive",
      "kind": "inlined",
      "load": 0.4
    },
    {
      "from": "renderer",
      "to": "scene",
      "kind": "dataflow",
      "load": 0.8
    },
    {
      "from": "renderer",
      "to": "interactive",
      "kind": "dataflow",
      "load": 0.5
    },
    {
      "from": "scene",
      "to": "readme",
      "load": 0.6,
      "label": "img tag"
    },
    {
      "from": "interactive",
      "to": "browser",
      "load": 0.5,
      "label": "opened directly"
    },
    {
      "from": "page",
      "to": "session",
      "kind": "async",
      "load": 0.4,
      "bidirectional": true,
      "label": "mount / change"
    },
    {
      "from": "scene",
      "to": "freeze",
      "load": 0.3,
      "label": "frame at t"
    },
    {
      "from": "freeze",
      "to": "resvg",
      "load": 0.3
    },
    {
      "from": "resvg",
      "to": "png",
      "kind": "dataflow",
      "load": 0.3
    },
    {
      "from": "aws-set",
      "to": "aws-pack",
      "kind": "builds",
      "load": 0.2
    },
    {
      "from": "gcp-set",
      "to": "gcp-pack",
      "kind": "builds",
      "load": 0.2
    },
    {
      "from": "azure-set",
      "to": "azure-pack",
      "kind": "replication",
      "load": 0.2,
      "meta": {
        "why": "the same drawing, copied"
      }
    }
  ],
  "callouts": [
    {
      "at": "model",
      "text": "One file: the model, its views, scenarios, tour and exports",
      "side": "top"
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "How Orrery works",
      "type": "topology",
      "description": "The whole pipeline, with the vocabulary, the runtime and the icon sets folded away.",
      "collapse": [
        "vocabulary",
        "packs",
        "runtime",
        "icon-sets"
      ]
    },
    {
      "id": "core",
      "title": "Inside core",
      "scope": "core",
      "direction": "down",
      "description": "Validate, declare, scope, render; the vocabulary is one box until you open it.",
      "collapse": [
        "vocabulary",
        "packs"
      ]
    },
    {
      "id": "author",
      "title": "The author's side",
      "only": [
        "agent",
        "model",
        "schema",
        "cli"
      ]
    },
    {
      "id": "out",
      "title": "What comes out",
      "only": [
        "renderer",
        "runtime",
        "outputs",
        "readme",
        "browser",
        "page"
      ],
      "collapse": [
        "runtime"
      ],
      "play": {
        "scenario": "invalid-model",
        "seconds": 3
      }
    },
    {
      "id": "render-seq",
      "type": "sequence",
      "title": "One render, as a sequence",
      "description": "What happens between the file and the picture when the agent runs orrery render.",
      "messages": [
        {
          "from": "agent",
          "to": "model",
          "text": "writes app.orrery.json"
        },
        {
          "from": "model",
          "to": "render",
          "text": "orrery render"
        },
        {
          "from": "render",
          "to": "validator",
          "text": "the file"
        },
        {
          "from": "validator",
          "to": "render",
          "text": "OK, or pointers",
          "reply": true
        },
        {
          "from": "validator",
          "to": "declare",
          "text": "the model"
        },
        {
          "from": "declare",
          "to": "scope",
          "text": "states, reasons, loads folded"
        },
        {
          "from": "scope",
          "to": "elk",
          "text": "layout graph"
        },
        {
          "from": "elk",
          "to": "scope",
          "text": "boxes and routes",
          "reply": true
        },
        {
          "from": "scope",
          "to": "renderer",
          "text": "laid out"
        },
        {
          "from": "renderer",
          "to": "renderer",
          "text": "CSS tracks"
        },
        {
          "from": "renderer",
          "to": "scene",
          "text": "SVG",
          "kind": "dataflow"
        },
        {
          "from": "scene",
          "to": "readme",
          "text": "img tag"
        }
      ],
      "play": {
        "seconds": 1
      }
    }
  ],
  "scenarios": [
    {
      "id": "invalid-model",
      "label": "The model has a mistake",
      "steps": [
        {
          "note": "A connection names a kind that does not exist",
          "set": {
            "outage": {
              "model": "/connections/7/kind: unknown connection kind \"grpc\""
            },
            "impaired": {
              "validate": "prints the pointer and the message"
            },
            "drained": [
              "declare",
              "scope",
              "elk",
              "renderer"
            ]
          },
          "load": [
            {
              "id": "to-render",
              "load": 0
            },
            {
              "from": "model",
              "to": "export",
              "load": 0
            }
          ],
          "callouts": [
            {
              "at": "validate",
              "text": "One line per error: a JSON pointer and a sentence. Nothing renders until the file is right."
            }
          ]
        },
        {
          "note": "The agent fixes the file; valid first time on the next run",
          "restore": [
            "model",
            "validate",
            "declare",
            "scope",
            "elk",
            "renderer"
          ],
          "load": [
            {
              "id": "to-render",
              "load": 0.7
            },
            {
              "from": "model",
              "to": "export",
              "load": 0.6
            }
          ],
          "callouts": [
            {
              "at": "model",
              "text": "Fixed at the pointer the error named",
              "side": "top"
            }
          ]
        }
      ]
    },
    {
      "id": "swap-engine",
      "label": "Swap the layout engine",
      "steps": [
        {
          "note": "ELK is drained; the fake engine takes the graph",
          "set": {
            "drained": {
              "elk": "replaced behind the LayoutEngine interface"
            },
            "brownout": "renderer"
          },
          "load": [
            {
              "id": "to-elk",
              "load": 0
            },
            {
              "id": "to-fake",
              "load": 0.7
            }
          ],
          "callouts": [
            {
              "at": "fake",
              "text": "Any engine behind one interface: a test engine today, a custom one tomorrow"
            }
          ]
        },
        {
          "note": "ELK is back",
          "restore": "elk",
          "set": {
            "healthy": "renderer"
          },
          "load": [
            {
              "id": "to-elk",
              "load": 0.7
            },
            {
              "id": "to-fake",
              "load": 0
            }
          ]
        }
      ]
    }
  ],
  "tour": {
    "seconds": 4,
    "scenes": [
      {
        "view": "overview",
        "note": "One file in, pictures out. Three groups are folded away."
      },
      {
        "view": "overview",
        "open": [
          "vocabulary"
        ],
        "note": "The vocabulary: states, kinds, shapes and packs, merged before the author's own."
      },
      {
        "view": "overview",
        "open": [
          "vocabulary",
          "packs"
        ],
        "zoom": "packs",
        "note": "Packs, two levels down: the providers' icon sets as kinds, sre as states."
      },
      {
        "view": "overview",
        "open": [
          "vocabulary",
          "runtime"
        ],
        "zoom": "runtime",
        "note": "The runtime, inlined into every interactive file: camera, session, morph.",
        "callouts": [
          {
            "at": "morph",
            "text": "Shared boxes slide between layouts",
            "side": "right"
          }
        ]
      },
      {
        "view": "overview",
        "scenario": "invalid-model",
        "step": 1,
        "note": "A mistake in the file: the validator answers, nothing renders."
      },
      {
        "view": "overview",
        "scenario": "invalid-model",
        "step": 2,
        "note": "Fixed at the pointer. Everything flows again."
      },
      {
        "view": "overview",
        "set": {
          "brownout": {
            "explain": "coming: the model and a scenario in prose"
          }
        },
        "seconds": 6,
        "note": "What is next: explain, in the author's words."
      }
    ]
  },
  "exports": [
    {
      "id": "overview"
    },
    {
      "id": "core",
      "view": "core"
    },
    {
      "id": "author",
      "view": "author"
    },
    {
      "id": "out",
      "view": "out",
      "play": "invalid-model",
      "seconds": 3
    },
    {
      "id": "open-vocabulary",
      "open": [
        "vocabulary"
      ]
    },
    {
      "id": "open-packs",
      "open": [
        "vocabulary",
        "packs"
      ],
      "zoom": "packs"
    },
    {
      "id": "zoom-renderer",
      "zoom": "renderer"
    },
    {
      "id": "open-runtime",
      "open": [
        "runtime"
      ],
      "zoom": "runtime"
    },
    {
      "id": "invalid-1",
      "scenario": "invalid-model",
      "step": 1
    },
    {
      "id": "invalid-2",
      "scenario": "invalid-model",
      "step": 2
    },
    {
      "id": "swap-engine",
      "scenario": "swap-engine",
      "step": 1
    },
    {
      "id": "what-if",
      "set": {
        "outage": {
          "resvg": "no native binary for this platform"
        }
      },
      "callouts": [
        {
          "at": "png",
          "text": "No frames without resvg; the SVGs are unaffected",
          "side": "right"
        }
      ]
    },
    {
      "id": "heading",
      "heading": true
    },
