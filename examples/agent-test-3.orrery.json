{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Payments platform",
  "direction": "right",
  "groups": [
    {
      "id": "edge",
      "label": "Edge",
      "kind": "tier"
    },
    {
      "id": "core",
      "label": "Payment services",
      "kind": "tier"
    },
    {
      "id": "data",
      "label": "Data",
      "kind": "tier"
    },
    {
      "id": "external",
      "label": "External processors",
      "kind": "boundary"
    }
  ],
  "components": [
    {
      "id": "checkout",
      "label": "Merchant checkout",
      "kind": "client",
      "group": "edge",
      "needs": [
        "api-gw"
      ]
    },
    {
      "id": "api-gw",
      "label": "API gateway",
      "kind": "gateway",
      "group": "edge",
      "needs": [
        "payments-svc"
      ]
    },
    {
      "id": "payments-svc",
      "label": "Payments service",
      "kind": "service",
      "group": "core",
      "needs": [
        {
          "any": [
            "pay-db-primary",
            "pay-db-replica"
          ]
        },
        {
          "any": [
            "stripe",
            "adyen"
          ]
        }
      ]
    },
    {
      "id": "fraud-svc",
      "label": "Fraud scoring",
      "kind": "service",
      "group": "core",
      "needs": [
        "fraud-cache"
      ]
    },
    {
      "id": "ledger-svc",
      "label": "Ledger writer",
      "kind": "service",
      "group": "core",
      "needs": [
        {
          "any": [
            "pay-db-primary",
            "pay-db-replica"
          ]
        }
      ]
    },
    {
      "id": "events",
      "label": "Payment events",
      "kind": "queue",
      "group": "core"
    },
    {
      "id": "pay-db-primary",
      "label": "Payments DB (primary)",
      "kind": "database",
      "group": "data"
    },
    {
      "id": "pay-db-replica",
      "label": "Payments DB (replica)",
      "kind": "database",
      "group": "data"
    },
    {
      "id": "fraud-cache",
      "label": "Fraud feature cache",
      "kind": "cache",
      "group": "data"
    },
    {
      "id": "stripe",
      "label": "Stripe",
      "kind": "external",
      "group": "external"
    },
    {
      "id": "adyen",
      "label": "Adyen (standby)",
      "kind": "external",
      "group": "external"
    }
  ],
  "connections": [
    {
      "from": "checkout",
      "to": "api-gw",
      "label": "HTTPS",
      "load": 0.8
    },
    {
      "from": "api-gw",
      "to": "payments-svc",
      "label": "gRPC",
      "load": 0.8
    },
    {
      "from": "payments-svc",
      "to": "fraud-svc",
      "label": "score",
      "load": 0.6
    },
    {
      "from": "fraud-svc",
      "to": "fraud-cache",
      "label": "features",
      "load": 0.6
    },
    {
      "from": "payments-svc",
      "to": "pay-db-primary",
      "label": "read/write",
      "load": 0.8
    },
    {
      "from": "payments-svc",
      "to": "pay-db-replica",
      "label": "failover",
      "load": 0
    },
    {
      "from": "pay-db-primary",
      "to": "pay-db-replica",
      "label": "streaming replication",
      "kind": "replication",
      "load": 0.4
    },
    {
      "from": "payments-svc",
      "to": "stripe",
      "label": "authorize/capture",
      "load": 0.7
    },
    {
      "from": "payments-svc",
      "to": "adyen",
      "label": "standby",
      "load": 0
    },
    {
      "from": "payments-svc",
      "to": "events",
      "label": "payment.captured",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "events",
      "to": "ledger-svc",
      "label": "consume",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "ledger-svc",
      "to": "pay-db-primary",
      "label": "append entries",
      "load": 0.4
    },
    {
      "from": "ledger-svc",
      "to": "pay-db-replica",
      "label": "failover",
      "load": 0
    }
  ],
  "scenarios": [
    {
      "id": "db-failover",
      "label": "Primary database fails; promote replica",
      "steps": [
        {
          "note": "The primary payments database crashes. Services that depend on it degrade onto their standby replica path.",
          "set": {
            "failed": "pay-db-primary"
          }
        },
        {
          "note": "Replica is promoted; traffic is switched to it.",
          "load": [
            {
              "from": "payments-svc",
              "to": "pay-db-replica",
              "load": 0.8
            },
            {
              "from": "ledger-svc",
              "to": "pay-db-replica",
              "load": 0.4
            },
            {
              "from": "payments-svc",
              "to": "pay-db-primary",
              "load": 0
            },
            {
              "from": "ledger-svc",
              "to": "pay-db-primary",
              "load": 0
            },
            {
              "from": "pay-db-primary",
              "to": "pay-db-replica",
              "load": 0
            }
          ]
        },
        {
          "note": "Old primary is taken out of service for rebuild; the platform runs fully on the promoted replica.",
          "set": {
            "off": "pay-db-primary"
          }
        }
      ]
    },
    {
      "id": "processor-outage",
      "label": "Stripe outage; route cards to Adyen",
      "steps": [
        {
          "note": "Stripe goes down. Payments service degrades and its standby Adyen path becomes available.",
          "set": {
            "failed": "stripe"
          }
        },
        {
          "note": "Card traffic is routed to Adyen.",
          "load": [
            {
              "from": "payments-svc",
              "to": "adyen",
              "load": 0.7
            },
            {
              "from": "payments-svc",
              "to": "stripe",
              "load": 0
            }
          ]
        }
      ]
    }
  ]
}
