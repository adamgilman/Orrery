{
  "$schema": "https://orrery.dev/schema/v1.json",
  "title": "Payments platform",
  "direction": "right",
  "groups": [
    {
      "id": "edge",
      "label": "Edge",
      "kind": "tier"
    },
    {
      "id": "core",
      "label": "Payment services",
      "kind": "tier"
    },
    {
      "id": "data",
      "label": "Data",
      "kind": "tier"
    },
    {
      "id": "external",
      "label": "External processors",
      "kind": "boundary"
    }
  ],
  "nodes": [
    {
      "id": "checkout",
      "label": "Merchant checkout",
      "kind": "client",
      "group": "edge"
    },
    {
      "id": "api-gw",
      "label": "API gateway",
      "kind": "gateway",
      "group": "edge"
    },
    {
      "id": "payments-svc",
      "label": "Payments service",
      "kind": "service",
      "group": "core"
    },
    {
      "id": "fraud-svc",
      "label": "Fraud scoring",
      "kind": "service",
      "group": "core"
    },
    {
      "id": "ledger-svc",
      "label": "Ledger writer",
      "kind": "service",
      "group": "core"
    },
    {
      "id": "events",
      "label": "Payment events",
      "kind": "queue",
      "group": "core"
    },
    {
      "id": "pay-db-primary",
      "label": "Payments DB (primary)",
      "kind": "database",
      "group": "data"
    },
    {
      "id": "pay-db-replica",
      "label": "Payments DB (replica)",
      "kind": "database",
      "group": "data"
    },
    {
      "id": "fraud-cache",
      "label": "Fraud feature cache",
      "kind": "cache",
      "group": "data"
    },
    {
      "id": "stripe",
      "label": "Stripe",
      "kind": "external",
      "group": "external"
    },
    {
      "id": "adyen",
      "label": "Adyen (standby)",
      "kind": "external",
      "group": "external"
    }
  ],
  "edges": [
    {
      "from": "checkout",
      "to": "api-gw",
      "label": "HTTPS",
      "load": 0.8,
      "dependsOn": true
    },
    {
      "from": "api-gw",
      "to": "payments-svc",
      "label": "gRPC",
      "load": 0.8,
      "dependsOn": true
    },
    {
      "from": "payments-svc",
      "to": "fraud-svc",
      "label": "score",
      "load": 0.6
    },
    {
      "from": "fraud-svc",
      "to": "fraud-cache",
      "label": "features",
      "load": 0.6,
      "dependsOn": true
    },
    {
      "from": "payments-svc",
      "to": "pay-db-primary",
      "label": "read/write",
      "load": 0.8,
      "dependsOn": true
    },
    {
      "from": "payments-svc",
      "to": "pay-db-replica",
      "label": "failover",
      "load": 0,
      "fallback": true,
      "fallbackFor": "payments-svc->pay-db-primary"
    },
    {
      "from": "pay-db-primary",
      "to": "pay-db-replica",
      "label": "streaming replication",
      "kind": "replication",
      "load": 0.4
    },
    {
      "from": "payments-svc",
      "to": "stripe",
      "label": "authorize/capture",
      "load": 0.7,
      "dependsOn": true
    },
    {
      "from": "payments-svc",
      "to": "adyen",
      "label": "standby",
      "load": 0,
      "fallback": true,
      "fallbackFor": "payments-svc->stripe"
    },
    {
      "from": "payments-svc",
      "to": "events",
      "label": "payment.captured",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "events",
      "to": "ledger-svc",
      "label": "consume",
      "kind": "async",
      "load": 0.5
    },
    {
      "from": "ledger-svc",
      "to": "pay-db-primary",
      "label": "append entries",
      "load": 0.4,
      "dependsOn": true
    },
    {
      "from": "ledger-svc",
      "to": "pay-db-replica",
      "label": "failover",
      "load": 0,
      "fallback": true,
      "fallbackFor": "ledger-svc->pay-db-primary"
    }
  ],
  "scenarios": [
    {
      "id": "db-failover",
      "label": "Primary database fails; promote replica",
      "steps": [
        {
          "note": "The primary payments database crashes. Services that depend on it degrade onto their standby replica path.",
          "nodes": {
            "pay-db-primary": {
              "state": "failed"
            }
          }
        },
        {
          "note": "Replica is promoted; traffic is switched to it.",
          "edges": {
            "payments-svc->pay-db-replica": {
              "load": 0.8
            },
            "ledger-svc->pay-db-replica": {
              "load": 0.4
            },
            "payments-svc->pay-db-primary": {
              "load": 0
            },
            "ledger-svc->pay-db-primary": {
              "load": 0
            },
            "pay-db-primary->pay-db-replica": {
              "load": 0
            }
          }
        },
        {
          "note": "Old primary is taken out of service for rebuild; the platform runs fully on the promoted replica.",
          "nodes": {
            "pay-db-primary": {
              "state": "off"
            }
          }
        }
      ]
    },
    {
      "id": "processor-outage",
      "label": "Stripe outage; route cards to Adyen",
      "steps": [
        {
          "note": "Stripe goes down. Payments service degrades and its standby Adyen path becomes available.",
          "nodes": {
            "stripe": {
              "state": "failed"
            }
          }
        },
        {
          "note": "Card traffic is routed to Adyen.",
          "edges": {
            "payments-svc->adyen": {
              "load": 0.7
            },
            "payments-svc->stripe": {
              "load": 0
            }
          }
        }
      ]
    }
  ]
}
