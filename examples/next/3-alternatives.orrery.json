{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Checkout with alternatives",
  "direction": "down",
  "groups": [
    { "id": "data", "label": "Data tier" },
    { "id": "psp", "label": "Payment providers", "kind": "boundary" }
  ],
  "components": [
    { "id": "web", "kind": "gateway", "needs": ["api"] },
    { "id": "api", "label": "Checkout API", "replicas": 3,
      "needs": [
        { "any": ["orders", "replica"] },
        { "any": ["stripe", "adyen"] },
        { "any": ["fraud"], "unmet": "degraded" }
      ] },
    { "id": "orders", "label": "Orders DB", "kind": "database", "group": "data" },
    { "id": "replica", "label": "Orders replica", "kind": "database", "group": "data" },
    { "id": "stripe", "kind": "external", "group": "psp" },
    { "id": "adyen", "kind": "external", "group": "psp" },
    { "id": "fraud", "label": "Fraud scoring", "kind": "function" }
  ],
  "connections": [
    { "from": "web", "to": "api", "load": 0.8 },
    { "from": "api", "to": "orders", "load": 0.6 },
    { "from": "api", "to": "replica", "load": 0 },
    { "from": "orders", "to": "replica", "kind": "replication", "load": 0.2 },
    { "from": "api", "to": "stripe", "load": 0.3 },
    { "from": "api", "to": "adyen", "load": 0 },
    { "from": "api", "to": "fraud", "kind": "async", "load": 0.3 }
  ],
  "scenarios": [
    { "id": "orders-failover", "label": "Orders DB failover", "steps": [
      { "note": "Primary goes down; reads move to the replica, API runs reduced", "set": { "failed": "orders" } },
      { "note": "Fraud scoring also down; still serving",                           "set": { "failed": "fraud" } },
      { "note": "Replica dies too; API fails, web fails behind it",                 "set": { "failed": "replica" } },
      { "note": "All back",                                                          "restore": ["orders", "fraud", "replica"] }
    ] },
    { "id": "stripe-outage", "label": "Stripe outage", "steps": [
      { "note": "Stripe returns 5xx; traffic shifts to Adyen", "set": { "failed": "stripe" } }
    ] }
  ]
}
