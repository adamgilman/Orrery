{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Typical web application",
  "direction": "right",
  "components": [
    {
      "id": "client",
      "label": "Browser / Mobile"
    },
    {
      "id": "lb",
      "label": "Load balancer"
    },
    {
      "id": "app1",
      "label": "App server 1"
    },
    {
      "id": "app2",
      "label": "App server 2"
    },
    {
      "id": "cache",
      "label": "Redis cache"
    },
    {
      "id": "db",
      "label": "PostgreSQL"
    },
    {
      "id": "queue",
      "label": "Message queue"
    },
    {
      "id": "worker",
      "label": "Background worker"
    }
  ],
  "connections": [
    {
      "from": "client",
      "to": "lb",
      "label": "HTTPS",
      "load": 0.9
    },
    {
      "from": "lb",
      "to": "app1",
      "load": 0.45
    },
    {
      "from": "lb",
      "to": "app2",
      "load": 0.45
    },
    {
      "from": "app1",
      "to": "cache",
      "label": "GET/SET",
      "load": 0.7
    },
    {
      "from": "app2",
      "to": "cache",
      "label": "GET/SET",
      "load": 0.7
    },
    {
      "from": "app1",
      "to": "db",
      "label": "SQL",
      "load": 0.3
    },
    {
      "from": "app2",
      "to": "db",
      "label": "SQL",
      "load": 0.3
    },
    {
      "from": "app1",
      "to": "queue",
      "label": "publish",
      "load": 0.15
    },
    {
      "from": "app2",
      "to": "queue",
      "label": "publish",
      "load": 0.15
    },
    {
      "from": "queue",
      "to": "worker",
      "label": "consume",
      "load": 0.25
    },
    {
      "from": "worker",
      "to": "db",
      "label": "SQL",
      "load": 0.1
    }
  ]
}
