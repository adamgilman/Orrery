{
  "name": "@orrery-diagrams/runtime",
  "version": "0.1.1",
  "description": "The engine inlined into every Orrery SVG: camera, states, scenarios, drill-down, tours; window.Orrery.mount for pages.",
  "keywords": [
    "orrery",
    "svg",
    "runtime",
    "interactive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamgilman/Orrery.git"
  },
  "homepage": "https://github.com/adamgilman/Orrery#readme",
  "bugs": {
    "url": "https://github.com/adamgilman/Orrery/issues"
  },
  "license": "MIT",
  "author": "Adam Gilman",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node bundle.mjs"
  },
  "dependencies": {
    "@orrery-diagrams/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30",
    "esbuild": "^0.28",
    "jsdom": "^30"
  }
}
