{
  "name": "orrery-diagrams",
  "version": "0.1.1",
  "description": "Animated, navigable architecture diagrams from a JSON model: validate, render, export and embed. The orrery command.",
  "keywords": [
    "architecture",
    "diagram",
    "svg",
    "animated",
    "c4",
    "infrastructure",
    "documentation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamgilman/Orrery.git"
  },
  "homepage": "https://github.com/adamgilman/Orrery#readme",
  "bugs": {
    "url": "https://github.com/adamgilman/Orrery/issues"
  },
  "license": "MIT",
  "author": "Adam Gilman",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "orrery": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sample"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@orrery-diagrams/core": "workspace:*",
    "@orrery-diagrams/layout-elk": "workspace:*",
    "@orrery-diagrams/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30",
    "jsdom": "^30"
  }
}
