{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orrery.dev/schema/v1.json",
  "title": "Orrery diagram (M0 subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "direction": { "type": "string", "enum": ["right", "down"], "default": "right" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "load": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
        }
      }
    }
  }
}
