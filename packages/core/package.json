{
  "name": "@orrery-diagrams/core",
  "version": "0.2.1",
  "description": "The Orrery model: schema, validator, declaration, view scoping, packs, shapes and the SVG renderer.",
  "keywords": [
    "architecture",
    "diagram",
    "svg",
    "model"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamgilman/Orrery.git"
  },
  "homepage": "https://github.com/adamgilman/Orrery#readme",
  "bugs": {
    "url": "https://github.com/adamgilman/Orrery/issues"
  },
  "license": "MIT",
  "author": "Adam Gilman",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./declare": {
      "types": "./dist/declare.d.ts",
      "default": "./dist/declare.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "schema"
  ],
  "scripts": {
    "build": "node scripts/embed.mjs && tsc -b"
  },
  "dependencies": {
    "ajv": "^8.17"
  }
}
