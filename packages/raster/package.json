{
  "name": "@orrery-diagrams/raster",
  "version": "0.1.0",
  "description": "Freeze Orrery animations at a moment and rasterise them: frames, contact sheets, pixel checks.",
  "keywords": [
    "orrery",
    "svg",
    "png",
    "raster"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamgilman/Orrery.git"
  },
  "homepage": "https://github.com/adamgilman/Orrery#readme",
  "bugs": {
    "url": "https://github.com/adamgilman/Orrery/issues"
  },
  "license": "MIT",
  "author": "Adam Gilman",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@orrery-diagrams/core": "workspace:*",
    "@resvg/resvg-js": "^2.6",
    "fast-xml-parser": "^5",
    "pngjs": "^7"
  },
  "devDependencies": {
    "@types/pngjs": "^6"
  }
}
