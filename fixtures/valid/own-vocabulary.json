{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Trading platform",
  "direction": "right",
  "states": {
    "default": "healthy",
    "replace": true,
    "define": {
      "healthy": {
        "look": "normal",
        "description": "Within SLO"
      },
      "impaired": {
        "look": "warn",
        "description": "Serving, redundancy or latency SLO breached"
      },
      "brownout": {
        "look": {
          "stroke": "#7c3aed",
          "fill": "#f5f3ff",
          "pulse": true
        },
        "description": "Serving with non-essential features disabled"
      },
      "outage": {
        "look": "alert",
        "flows": "stop",
        "description": "Customer-visible failure"
      },
      "drained": {
        "look": "muted",
        "flows": "stop",
        "description": "Deliberately taken out of rotation"
      }
    }
  },
  "kinds": {
    "components": {
      "matcher": {
        "glyph": "M2 8h4l2-5 2 10 2-5h4",
        "description": "Order matching engine"
      },
      "mainframe": {
        "glyph": "storage",
        "box": {
          "dash": false,
          "fill": "#fefce8"
        },
        "description": "Settlement on z/OS"
      }
    },
    "groups": {
      "cell": {
        "frame": {
          "stroke": "#0891b2",
          "dash": true,
          "fill": "#ecfeff",
          "fillOpacity": 0.4
        },
        "description": "Independent deployment cell"
      }
    },
    "connections": {
      "gossip": {
        "line": {
          "dash": "2 3",
          "stroke": "#0891b2",
          "flow": "#0891b2"
        },
        "description": "Consensus gossip between sequencers"
      }
    }
  },
  "groups": [
    {
      "id": "eu",
      "label": "EU",
      "kind": "region"
    },
    {
      "id": "cell-a",
      "label": "Cell A",
      "kind": "cell",
      "parent": "eu"
    },
    {
      "id": "cell-b",
      "label": "Cell B",
      "kind": "cell",
      "parent": "eu"
    },
    {
      "id": "consensus",
      "label": "Sequencer quorum",
      "kind": "cluster",
      "parent": "eu"
    },
    {
      "id": "settlement",
      "label": "Settlement",
      "kind": "boundary",
      "description": "Not opened yet: a black box the platform needs"
    }
  ],
  "components": [
    {
      "id": "edge",
      "label": "Edge gateway",
      "kind": "gateway"
    },
    {
      "id": "match-a",
      "label": "Matcher",
      "kind": "matcher",
      "group": "cell-a"
    },
    {
      "id": "match-b",
      "label": "Matcher",
      "kind": "matcher",
      "group": "cell-b"
    },
    {
      "id": "seq-1",
      "label": "Sequencer 1",
      "group": "consensus"
    },
    {
      "id": "seq-2",
      "label": "Sequencer 2",
      "group": "consensus"
    },
    {
      "id": "seq-3",
      "label": "Sequencer 3",
      "group": "consensus"
    },
    {
      "id": "ledger",
      "label": "Ledger",
      "kind": "mainframe",
      "group": "settlement",
      "state": "healthy",
      "meta": {
        "owner": "core-banking",
        "runbook": "https://runbooks/ledger"
      }
    }
  ],
  "connections": [
    {
      "from": "edge",
      "to": "cell-a",
      "load": 0.5,
      "label": "orders"
    },
    {
      "from": "edge",
      "to": "cell-b",
      "load": 0.5,
      "label": "orders"
    },
    {
      "from": "match-a",
      "to": "consensus",
      "load": 0.7,
      "label": "sequence"
    },
    {
      "from": "match-b",
      "to": "consensus",
      "load": 0.7,
      "label": "sequence"
    },
    {
      "from": "seq-1",
      "to": "seq-2",
      "kind": "gossip",
      "bidirectional": true,
      "load": 0.3
    },
    {
      "from": "seq-2",
      "to": "seq-3",
      "kind": "gossip",
      "bidirectional": true,
      "load": 0.3
    },
    {
      "from": "seq-3",
      "to": "seq-1",
      "kind": "gossip",
      "bidirectional": true,
      "load": 0.3
    },
    {
      "from": "match-a",
      "to": "settlement",
      "kind": "async",
      "load": 0.2,
      "label": "fills"
    },
    {
      "from": "match-b",
      "to": "settlement",
      "kind": "async",
      "load": 0.2,
      "label": "fills"
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Trading platform"
    },
    {
      "id": "eu-only",
      "title": "EU region",
      "scope": "eu"
    },
    {
      "id": "matching",
      "title": "Matching path",
      "only": [
        "edge",
        "cell-a",
        "cell-b",
        "consensus"
      ],
      "direction": "down"
    }
  ],
  "scenarios": [
    {
      "id": "cell-drain",
      "label": "Drain cell A for deploy",
      "steps": [
        {
          "note": "Cell A drained, its matcher with it; the edge runs impaired on cell B",
          "set": {
            "drained": [
              "cell-a",
              "match-a"
            ],
            "impaired": {
              "edge": "running on cell B alone"
            }
          },
          "load": [
            {
              "from": "edge",
              "to": "cell-b",
              "load": 1
            }
          ]
        },
        {
          "note": "Back in rotation",
          "restore": [
            "cell-a",
            "match-a",
            "edge"
          ],
          "load": [
            {
              "from": "edge",
              "to": "cell-b",
              "load": 0.5
            }
          ]
        }
      ]
    },
    {
      "id": "quorum",
      "label": "Sequencer quorum loss",
      "steps": [
        {
          "note": "One sequencer out: quorum holds, matchers impaired",
          "set": {
            "outage": "seq-1",
            "impaired": {
              "match-a": "two of three sequencers",
              "match-b": "two of three sequencers",
              "consensus": "one sequencer out"
            }
          }
        },
        {
          "note": "Second out: quorum lost, both matchers in outage, edge in outage",
          "set": {
            "outage": {
              "seq-2": "disk failure",
              "match-a": "quorum lost",
              "match-b": "quorum lost",
              "consensus": "quorum lost",
              "edge": "no matcher available"
            }
          }
        },
        {
          "note": "Second sequencer back; edge in brownout while it catches up",
          "restore": [
            "seq-2"
          ],
          "set": {
            "brownout": {
              "edge": "read-only while the sequencer catches up"
            },
            "impaired": {
              "match-a": "two of three sequencers",
              "match-b": "two of three sequencers",
              "consensus": "catching up"
            }
          }
        }
      ]
    },
    {
      "id": "settlement-box",
      "label": "Settlement black box fails",
      "steps": [
        {
          "note": "The whole settlement boundary is in outage; the ledger inside is untouched, matchers run impaired",
          "set": {
            "outage": "settlement",
            "impaired": {
              "match-a": "settlement unavailable",
              "match-b": "settlement unavailable"
            }
          }
        }
      ]
    }
  ]
}
