{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Commerce platform",
  "direction": "right",
  "groups": [
    {
      "id": "storefront",
      "label": "Storefront",
      "kind": "tier"
    },
    {
      "id": "payments",
      "label": "Payments",
      "kind": "boundary",
      "description": "PCI scope"
    },
    {
      "id": "identity",
      "label": "Identity",
      "kind": "tier"
    },
    {
      "id": "pay-core",
      "label": "Core",
      "kind": "tier",
      "parent": "payments"
    }
  ],
  "components": [
    {
      "id": "web",
      "label": "Web",
      "kind": "gateway",
      "group": "storefront",
      "needs": [
        "checkout"
      ]
    },
    {
      "id": "checkout",
      "label": "Checkout",
      "kind": "service",
      "group": "storefront",
      "needs": [
        "payments",
        "identity"
      ]
    },
    {
      "id": "catalog",
      "label": "Catalog",
      "kind": "service",
      "group": "storefront"
    },
    {
      "id": "pay-api",
      "label": "Payments API",
      "kind": "service",
      "group": "pay-core",
      "needs": [
        {
          "any": [
            "ledger",
            "ledger-replica"
          ]
        },
        "tokens",
        {
          "any": [
            "stripe",
            "adyen"
          ]
        }
      ]
    },
    {
      "id": "ledger",
      "label": "Ledger",
      "kind": "database",
      "group": "pay-core"
    },
    {
      "id": "ledger-replica",
      "label": "Ledger replica",
      "kind": "database",
      "group": "pay-core"
    },
    {
      "id": "tokens",
      "label": "Card vault",
      "kind": "storage",
      "group": "payments"
    },
    {
      "id": "stripe",
      "label": "Stripe",
      "kind": "external"
    },
    {
      "id": "adyen",
      "label": "Adyen",
      "kind": "external"
    },
    {
      "id": "login",
      "label": "Login",
      "kind": "service",
      "group": "identity",
      "needs": [
        "sessions"
      ]
    },
    {
      "id": "sessions",
      "label": "Sessions",
      "kind": "cache",
      "group": "identity"
    }
  ],
  "connections": [
    {
      "from": "web",
      "to": "checkout",
      "load": 0.8
    },
    {
      "from": "web",
      "to": "catalog",
      "load": 0.6
    },
    {
      "from": "checkout",
      "to": "pay-api",
      "load": 0.5,
      "label": "charge"
    },
    {
      "from": "checkout",
      "to": "login",
      "load": 0.4
    },
    {
      "from": "pay-api",
      "to": "ledger",
      "load": 0.5
    },
    {
      "from": "pay-api",
      "to": "ledger-replica",
      "load": 0
    },
    {
      "from": "ledger",
      "to": "ledger-replica",
      "kind": "replication",
      "load": 0.2
    },
    {
      "from": "pay-api",
      "to": "tokens",
      "load": 0.3
    },
    {
      "from": "pay-api",
      "to": "stripe",
      "load": 0.3
    },
    {
      "from": "pay-api",
      "to": "adyen",
      "load": 0
    },
    {
      "from": "login",
      "to": "sessions",
      "load": 0.4
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Platform",
      "collapse": [
        "payments",
        "identity"
      ]
    },
    {
      "id": "payments",
      "title": "Inside Payments",
      "scope": "payments",
      "direction": "down"
    },
    {
      "id": "identity",
      "title": "Inside Identity",
      "scope": "identity",
      "direction": "down"
    }
  ],
  "scenarios": [
    {
      "id": "ledger-fails",
      "label": "Ledger fails",
      "steps": [
        {
          "note": "Primary ledger goes down",
          "set": {
            "failed": "ledger"
          }
        }
      ]
    }
  ]
}
