{
  "$schema": "https://raw.githubusercontent.com/adamgilman/Orrery/main/packages/core/schema/v1.json",
  "title": "Commerce platform",
  "direction": "right",
  "groups": [
    {
      "id": "storefront",
      "label": "Storefront",
      "kind": "tier"
    },
    {
      "id": "payments",
      "label": "Payments",
      "kind": "boundary",
      "description": "PCI scope"
    },
    {
      "id": "identity",
      "label": "Identity",
      "kind": "tier"
    },
    {
      "id": "pay-core",
      "label": "Core",
      "kind": "tier",
      "parent": "payments"
    }
  ],
  "components": [
    {
      "id": "web",
      "label": "Web",
      "kind": "gateway",
      "group": "storefront"
    },
    {
      "id": "checkout",
      "label": "Checkout",
      "kind": "service",
      "group": "storefront"
    },
    {
      "id": "catalog",
      "label": "Catalog",
      "kind": "service",
      "group": "storefront"
    },
    {
      "id": "pay-api",
      "label": "Payments API",
      "kind": "service",
      "group": "pay-core"
    },
    {
      "id": "ledger",
      "label": "Ledger",
      "kind": "database",
      "group": "pay-core"
    },
    {
      "id": "ledger-replica",
      "label": "Ledger replica",
      "kind": "database",
      "group": "pay-core"
    },
    {
      "id": "tokens",
      "label": "Card vault",
      "kind": "storage",
      "group": "payments"
    },
    {
      "id": "stripe",
      "label": "Stripe",
      "kind": "external"
    },
    {
      "id": "adyen",
      "label": "Adyen",
      "kind": "external"
    },
    {
      "id": "login",
      "label": "Login",
      "kind": "service",
      "group": "identity"
    },
    {
      "id": "sessions",
      "label": "Sessions",
      "kind": "cache",
      "group": "identity"
    }
  ],
  "connections": [
    {
      "from": "web",
      "to": "checkout",
      "load": 0.8
    },
    {
      "from": "web",
      "to": "catalog",
      "load": 0.6
    },
    {
      "from": "checkout",
      "to": "pay-api",
      "load": 0.5,
      "label": "charge"
    },
    {
      "from": "checkout",
      "to": "login",
      "load": 0.4
    },
    {
      "from": "pay-api",
      "to": "ledger",
      "load": 0.5
    },
    {
      "from": "pay-api",
      "to": "ledger-replica",
      "load": 0
    },
    {
      "from": "ledger",
      "to": "ledger-replica",
      "kind": "replication",
      "load": 0.2
    },
    {
      "from": "pay-api",
      "to": "tokens",
      "load": 0.3
    },
    {
      "from": "pay-api",
      "to": "stripe",
      "load": 0.3
    },
    {
      "from": "pay-api",
      "to": "adyen",
      "load": 0
    },
    {
      "from": "login",
      "to": "sessions",
      "load": 0.4
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Platform",
      "collapse": [
        "payments",
        "identity"
      ]
    },
    {
      "id": "payments",
      "title": "Inside Payments",
      "scope": "payments",
      "direction": "down"
    },
    {
      "id": "identity",
      "title": "Inside Identity",
      "scope": "identity",
      "direction": "down"
    }
  ],
  "scenarios": [
    {
      "id": "ledger-fails",
      "label": "Ledger fails",
      "steps": [
        {
          "note": "Primary ledger goes down",
          "set": {
            "failed": "ledger",
            "degraded": {
              "pay-api": "running on the replica",
              "payments": "reduced redundancy",
              "checkout": "payments are slower"
            }
          },
          "load": [
            {
              "from": "pay-api",
              "to": "ledger-replica",
              "load": 0.5
            }
          ]
        }
      ]
    }
  ],
  "tour": {
    "seconds": 4,
    "scenes": [
      {
        "view": "overview",
        "note": "The platform. Payments and Identity are closed."
      },
      {
        "view": "overview",
        "focus": "payments",
        "note": "Inside Payments: the API needs the ledger or its replica."
      },
      {
        "view": "overview",
        "focus": "payments",
        "scenario": "ledger-fails",
        "step": 1,
        "note": "The ledger fails. The API runs reduced on the replica."
      },
      {
        "view": "overview",
        "scenario": "ledger-fails",
        "step": 1,
        "note": "Back out: the closed box and the checkout that needs it are amber."
      }
    ]
  }
}
