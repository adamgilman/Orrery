{
  "name": "orrery-monorepo",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "orrery": "node packages/cli/dist/main.js",
    "examples": "yarn build && node packages/cli/dist/main.js render examples/three-tier.orrery.json -o examples/three-tier.svg && node packages/cli/dist/main.js render fixtures/valid/fan-out.json -o examples/fan-out.svg",
    "inspect": "node tools/inspect.mjs"
  },
  "devDependencies": {
    "@orrery/layout-elk": "workspace:*",
    "@orrery/raster": "workspace:*",
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^3"
  },
  "license": "MIT"
}
