{
  "name": "orrery-monorepo",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/core/scripts/embed.mjs && tsc -b && yarn workspace @orrery-diagrams/runtime run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run test/orrery/regression.test.ts",
    "test:smoke": "vitest run test/orrery/smoke.test.ts",
    "test:integration": "vitest run test/orrery/integration.test.ts",
    "perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "node packages/core/scripts/embed.mjs && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "yarn typecheck && yarn lint && yarn test && ORRERY_SKIP_BUILD=1 yarn perf",
    "orrery": "node packages/cli/dist/main.js",
    "examples": "yarn build && node tools/examples.mjs",
    "inspect": "node tools/inspect.mjs",
    "site": "node site/build.mjs && node site/landing/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orrery-diagrams/pack-aws": "workspace:*",
    "@orrery-diagrams/pack-azure": "workspace:*",
    "@orrery-diagrams/pack-gcp": "workspace:*",
    "@types/jsdom": "^30",
    "@types/node": "^26",
    "aws-icons": "3.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30",
    "lucide-static": "^1.42.0",
    "playwright": "1.62",
    "typescript": "^5.6",
    "typescript-eslint": "^8.69.0",
    "vite": "^8",
    "vitest": "^5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "version": "0.3.0"
}
