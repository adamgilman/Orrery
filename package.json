{
  "name": "orrery-monorepo",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && yarn workspace @orrery/runtime run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "yarn typecheck && yarn lint && yarn test",
    "orrery": "node packages/cli/dist/main.js",
    "examples": "yarn build && node tools/examples.mjs",
    "inspect": "node tools/inspect.mjs",
    "site": "node site/build.mjs && node site/landing/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "aws-icons": "3.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "1.62",
    "typescript": "^5.6",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
